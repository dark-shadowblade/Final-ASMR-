{
  "name": "final-asmr",
  "version": "0.1.0",
  "description": "Final ASMR five-profile Flow browser launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "test": "node --check main.js && node --check preload.js && node --check renderer.js && node --check extension/background.js && node --check extension/content.js && node --check extension/options.js"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.darkshadowblade.finalasmr",
    "productName": "Final ASMR",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "package.json",
      "extension/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Final-ASMR-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
