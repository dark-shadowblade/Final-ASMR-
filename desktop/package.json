{
  "name": "final-asmr",
  "version": "0.1.0",
  "description": "Final ASMR five-profile Flow browser launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.darkshadowblade.finalasmr",
    "productName": "Final ASMR",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "package.json"],
    "win": {
      "target": ["nsis"],
      "artifactName": "Final-ASMR-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}