{
  "manifest_version": 3,
  "name": "Final ASMR Flow Worker",
  "version": "0.1.0",
  "description": "Receives one assigned prompt and operates the matching Google Flow project.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "downloads",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Final ASMR Flow Worker"
  }
}
